# Публичный URL продакшена (canonical, sitemap, OG, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://logicamarketing.pro

# Поисковые системы — подставьте коды из Search Console / Яндекс.Вебмастер
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Опционально: @brand для Twitter-карточек (site/creator)
NEXT_PUBLIC_TWITTER_SITE=

# Заявки с форм (/api/lead): либо Telegram-бот, либо свой webhook (JSON POST)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# LEAD_WEBHOOK_URL=

# Cloudflare Turnstile (опционально). Без ключей капча на формах не показывается.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Лимит заявок: по умолчанию in-memory по IP. Если заданы переменные Upstash — Redis (несколько инстансов / serverless).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Webhook при ошибке доставки лида (Slack, n8n, второй Telegram и т.д.) — JSON POST.
# LEAD_FAILURE_WEBHOOK_URL=

# Публичная ссылка на бронирование (Cal.com, Calendly) — кнопка на странице контактов.
# NEXT_PUBLIC_BOOKING_URL=

# Google Analytics (Measurement ID) — скрипты грузятся только после «Принять» в баннере cookies.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Дополнительные переменные для сборки/рантайма (если нужны):
# PORT=3000
